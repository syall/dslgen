use crate::ast::{BinOp, Expr, Stmt};

grammar;

/// The parser's actual entry point (session A11): a program is a statement
/// sequence followed by a mandatory result expression, exactly like a `Block`'s
/// insides — but without the surrounding `{ }`, so `print(1); 2` is a complete
/// program on its own, not just `{ print(1); 2 }`. When there are no leading
/// statements, this produces the bare result `Expr` directly rather than an
/// `Expr::Block` wrapping nothing — preserving every existing program's exact AST
/// shape (e.g. `1 + 2` still parses to `Expr::BinOp(..)`, not `Expr::Block { stmts:
/// vec![], result: .. }`).
pub Program: Expr = {
    <stmts:Stmt*> <result:Expr> => if stmts.is_empty() {
        result
    } else {
        Expr::Block { stmts, result: Box::new(result) }
    },
};

Expr: Expr = {
    <l:Expr> "+" <r:Factor> => Expr::BinOp(Box::new(l), BinOp::Add, Box::new(r)),
    <l:Expr> "-" <r:Factor> => Expr::BinOp(Box::new(l), BinOp::Sub, Box::new(r)),
    Factor,
};

Factor: Expr = {
    <l:Factor> "*" <r:Term> => Expr::BinOp(Box::new(l), BinOp::Mul, Box::new(r)),
    <l:Factor> "/" <r:Term> => Expr::BinOp(Box::new(l), BinOp::Div, Box::new(r)),
    Term,
};

Term: Expr = {
    Num => Expr::Number(<>),
    Ident => Expr::Var(<>),
    "if" <c:Expr> <t:Block> "else" <e:Block> =>
        Expr::If { cond: Box::new(c), then_branch: Box::new(t), else_branch: Box::new(e) },
    "(" <Expr> ")",
    Block,
};

Block: Expr = {
    "{" <stmts:Stmt*> <result:Expr> "}" => Expr::Block { stmts, result: Box::new(result) },
};

Stmt: Stmt = {
    "let" <name:Ident> "=" <value:Expr> ";" => Stmt::Let { name, value },
    "print" "(" <e:Expr> ")" ";" => Stmt::Print(e),
};

Num: f64 = r"[0-9]+(\.[0-9]+)?" => <>.parse().unwrap();
Ident: String = r"[a-zA-Z_][a-zA-Z0-9_]*" => <>.to_string();
