use crate::ast::{BinOp, Expr};

grammar;

pub Expr: Expr = {
    <l:Expr> "+" <r:Factor> => Expr::BinOp(Box::new(l), BinOp::Add, Box::new(r)),
    <l:Expr> "-" <r:Factor> => Expr::BinOp(Box::new(l), BinOp::Sub, Box::new(r)),
    Factor,
};

Factor: Expr = {
    <l:Factor> "*" <r:Term> => Expr::BinOp(Box::new(l), BinOp::Mul, Box::new(r)),
    <l:Factor> "/" <r:Term> => Expr::BinOp(Box::new(l), BinOp::Div, Box::new(r)),
    Term,
};

Term: Expr = {
    Num => Expr::Number(<>),
    Ident => Expr::Var(<>),
    "if" <c:Expr> "{" <t:Expr> "}" "else" "{" <e:Expr> "}" =>
        Expr::If { cond: Box::new(c), then_branch: Box::new(t), else_branch: Box::new(e) },
    "(" <Expr> ")",
};

Num: f64 = r"[0-9]+(\.[0-9]+)?" => <>.parse().unwrap();
Ident: String = r"[a-zA-Z_][a-zA-Z0-9_]*" => <>.to_string();
